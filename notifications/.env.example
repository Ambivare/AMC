# Copy this file to .env and fill in real values before running the service.
# See setup.md for exactly where each value comes from.

# ── Firebase service account ────────────────────────────────────────────────
# Path to the service-account JSON key file (recommended — see setup.md step 2).
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Alternative to the path above: paste the ENTIRE JSON key as a single-line
# string here instead (useful if your VPS provider only lets you set env vars,
# e.g. in a systemd unit or a hosting panel). Leave blank if using the path.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"avantelevators-dff70",...}

# ── Behaviour ────────────────────────────────────────────────────────────────
# IANA timezone used for all "due" date math and cron scheduling.
TZ=Asia/Kolkata

# Days-before-due to send AMC payment installment reminders (comma separated).
AMC_PAYMENT_REMINDER_DAYS=7,3,1

# Days-before/after-due to send AMC maintenance reminders (0 = due today,
# positive = that many days overdue).
AMC_MAINTENANCE_REMINDER_DAYS=0,3,7
